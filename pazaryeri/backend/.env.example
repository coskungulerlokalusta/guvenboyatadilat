# MarkaBahçem API ayarları
PORT=8080
NODE_ENV=production

# Yönetim panelinin API'ye erişmek için kullandığı gizli anahtar.
# Uzun ve tahmin edilemez bir değer seçin; yönetim panelindeki
# Entegrasyonlar > Sunucu bağlantısı alanına aynısını girin.
ADMIN_PANEL_KEY=buraya-uzun-rastgele-bir-anahtar-yazin

# Sitenin açık adresi (iyzico 3D Secure dönüşü için)
PUBLIC_URL=https://www.markabahcem.com

# İsteğe bağlı: panelden kayıt yapılmadıysa bu değerler kullanılır
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_ORIGINATOR=MARKABAHCEM
